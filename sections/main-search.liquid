<section class="section-stub" aria-labelledby="SearchHeading-{{ section.id }}">
  <div class="page-width">
    <h1 id="SearchHeading-{{ section.id }}">{{ 'general.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search">
      <label for="SearchInput-{{ section.id }}">{{ 'general.search.placeholder' | t }}</label>
      <input
        id="SearchInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
      >
      <button type="submit">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        {%- paginate search.results by 10 -%}
          <ul role="list">
            {%- for item in search.results -%}
              <li>
                <a href="{{ item.url }}">{{ item.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
          {{ paginate | default_pagination }}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
