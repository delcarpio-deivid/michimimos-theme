{%- comment -%}
  Búsqueda: H1, formulario claro, resultados tipográficos.
{%- endcomment -%}

<section class="search-page" aria-labelledby="SearchHeading-{{ section.id }}">
  <div class="page-width search-page__inner">
    <header class="search-page__header">
      <h1 id="SearchHeading-{{ section.id }}" class="search-page__title">
        {{ 'general.search.title' | t }}
      </h1>
    </header>

    <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="search-page__label" for="SearchInput-{{ section.id }}">
        {{ 'general.search.placeholder' | t }}
      </label>
      <div class="search-page__row">
        <input
          id="SearchInput-{{ section.id }}"
          class="search-page__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
        >
        <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="search-page__empty">
          {{ 'general.search.no_results' | t: terms: search.terms }}
        </p>
      {%- else -%}
        {%- paginate search.results by 12 -%}
          <ul class="search-page__list" role="list">
            {%- for item in search.results -%}
              <li class="search-page__item">
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a class="search-page__link" href="{{ item.url }}">
                    <span class="search-page__link-title">{{ item.title | escape }}</span>
                    {%- if item.object_type != blank -%}
                      <span class="search-page__link-type">{{ item.object_type | escape }}</span>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- if paginate.pages > 1 -%}
            <nav class="search-page__pagination" aria-label="{{ 'general.search.title' | t }}">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
