<section class="section-stub" aria-labelledby="NotFoundHeading-{{ section.id }}">
  <div class="page-width">
    <h1 id="NotFoundHeading-{{ section.id }}">{{ 'general.404.title' | t }}</h1>
    <p>{{ 'general.404.subtext' | t }}</p>
    <a class="button" href="{{ routes.root_url }}">{{ 'general.404.link' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
