{%- comment -%}
  Header: desktop — mark + búsqueda + CL/Cuenta/Carrito; nav debajo sin divisor.
  Móvil: hamburguesa + logo + carrito; búsqueda en drawer.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign use_canonical = section.settings.use_canonical_nav
-%}

<header class="site-header" role="banner" data-site-header>
  <div class="page-width site-header__top">
    <button
      type="button"
      class="site-header__menu-toggle"
      data-nav-toggle
      data-label-open="{{ 'header.menu_open' | t | escape }}"
      data-label-close="{{ 'header.menu_close' | t | escape }}"
      aria-expanded="false"
      aria-controls="SiteNav-{{ section.id }}"
      aria-label="{{ 'header.menu_open' | t }}"
    >
      <span class="site-header__menu-icon" aria-hidden="true"></span>
    </button>

    {% render 'logo', variant: 'mark', class: 'logo site-header__logo' %}

    <form
      class="site-header__search"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
    >
      <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">
        {{ 'header.search' | t }}
      </label>
      <input
        id="HeaderSearch-{{ section.id }}"
        class="site-header__search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t | escape }}"
        autocomplete="off"
      >
      <button
        type="submit"
        class="site-header__search-submit"
        aria-label="{{ 'header.search' | t }}"
      >
        <svg class="site-header__search-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </form>

    <div class="site-header__actions">
      <span
        class="site-header__market"
        title="{{ 'header.market_cl' | t | escape }}"
      >
        <span class="site-header__flag" aria-hidden="true">
          <svg width="22" height="15" viewBox="0 0 22 15" focusable="false">
            <rect width="22" height="15" fill="#fff"/>
            <rect y="7.5" width="22" height="7.5" fill="#d52b1e"/>
            <rect width="8.5" height="7.5" fill="#0039a6"/>
            <path
              fill="#fff"
              d="M4.25 1.35l.55 1.7h1.78l-1.44 1.05.55 1.7-1.44-1.05-1.44 1.05.55-1.7L2 3.05h1.78z"
            />
          </svg>
        </span>
        <span class="site-header__market-label">CL</span>
      </span>

      {%- if shop.customer_accounts_enabled -%}
        <a
          class="site-header__action site-header__action--account"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
        >
          <span class="site-header__action-label">
            {%- if customer -%}
              {{ 'header.account' | t }}
            {%- else -%}
              {{ 'header.login' | t }}
            {%- endif -%}
          </span>
          <svg class="site-header__action-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="8" r="3.25" fill="none" stroke="currentColor" stroke-width="1.75"/>
            <path
              d="M5.5 19.25c.9-3.2 3.2-4.75 6.5-4.75s5.6 1.55 6.5 4.75"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            />
          </svg>
        </a>
      {%- endif -%}

      <button
        type="button"
        class="site-header__cart-toggle"
        data-cart-toggle
        aria-expanded="false"
        aria-controls="CartDrawer"
        aria-label="{{ 'cart.title' | t }}"
      >
        <span class="site-header__cart-label">{{ 'header.cart' | t }}</span>
        <span class="site-header__cart-icon-wrap" aria-hidden="true">
          <svg class="site-header__action-icon" width="20" height="20" viewBox="0 0 24 24" focusable="false">
            <path
              d="M6.5 8.5h11l-.9 9.2a1.5 1.5 0 0 1-1.5 1.35H8.9a1.5 1.5 0 0 1-1.5-1.35L6.5 8.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linejoin="round"
            />
            <path
              d="M9 8.5V7a3 3 0 0 1 6 0v1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            />
          </svg>
          <span
            class="site-header__cart-count"
            data-cart-count
            aria-live="polite"
            aria-atomic="true"
          >
            {{- cart.item_count -}}
          </span>
        </span>
      </button>
    </div>
  </div>

  <nav
    id="SiteNav-{{ section.id }}"
    class="site-header__nav-panel"
    data-nav-panel
    aria-label="{{ 'header.nav_label' | t }}"
  >
    <div class="page-width site-header__nav-inner">
      {%- if use_canonical or menu == blank -%}
        {% render 'nav-canonical', list_class: 'site-header__nav' %}
      {%- else -%}
        <ul class="site-header__nav" role="list">
          {%- for link in menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                {% if link.active %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <ul class="site-header__nav-mobile-extras" role="list">
        <li>
          <a href="{{ routes.search_url }}">{{ 'header.search' | t }}</a>
        </li>
        {%- if shop.customer_accounts_enabled -%}
          <li>
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
              {%- if customer -%}
                {{ 'header.account' | t }}
              {%- else -%}
                {{ 'header.login' | t }}
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </nav>

  <div class="site-header__backdrop" data-nav-backdrop hidden></div>
</header>

{% render 'cart-drawer' %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_canonical_nav",
      "label": "t:sections.header.settings.use_canonical_nav.label",
      "info": "t:sections.header.settings.use_canonical_nav.info",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "info": "t:sections.header.settings.menu.info",
      "default": "main-menu"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
