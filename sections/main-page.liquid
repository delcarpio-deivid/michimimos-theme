<section class="section-stub" aria-labelledby="PageHeading-{{ section.id }}">
  <div class="page-width">
    <h1 id="PageHeading-{{ section.id }}">{{ page.title | escape }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_page.name",
  "tag": "section",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
