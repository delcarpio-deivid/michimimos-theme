{%- comment -%}
  FAQ tipográfico en PDP (pregunta + respuesta visibles; sin caja de acordeón).
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  {%- liquid
    assign heading = section.settings.heading
    if heading == blank
      assign heading = 'products.faq.heading' | t
    endif
  -%}

  <section class="product-faq" aria-labelledby="ProductFaqHeading-{{ section.id }}">
    <div class="page-width product-faq__inner">
      <h2 id="ProductFaqHeading-{{ section.id }}" class="product-faq__heading">
        {{ heading | escape }}
      </h2>

      <div class="product-faq__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign question = block.settings.question
            assign answer = block.settings.answer
          -%}
          {%- if question != blank -%}
            <div class="product-faq__item" {{ block.shopify_attributes }}>
              <h3 class="product-faq__question">{{ question | escape }}</h3>
              {%- if answer != blank -%}
                <div class="product-faq__answer rte">{{ answer }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_faq.name",
  "tag": "section",
  "class": "section-product-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_faq.settings.heading.label",
      "default": "Preguntas frecuentes"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "t:sections.product_faq.blocks.faq_item.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.product_faq.blocks.faq_item.settings.question.label",
          "default": "¿Cuánto tarda el envío a Chile o Perú?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.product_faq.blocks.faq_item.settings.answer.label",
          "default": "<p>Te contamos el plazo estimado en la ficha cuando esté disponible. Si no lo ves, escríbenos y te orientamos con calma según tu ciudad.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_faq.name",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "¿Cuánto tarda el envío a Chile o Perú?",
            "answer": "<p>Te contamos el plazo estimado en la ficha cuando esté disponible. Si no lo ves, escríbenos y te orientamos con calma según tu ciudad.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo elijo el tamaño adecuado para mi gato?",
            "answer": "<p>Revisa medidas y peso recomendado en la descripción. Si tu gato es grande o muy activo, prioriza estructuras firmes y espacio para estirarse.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "¿Puedo devolver el producto si no encaja en casa?",
            "answer": "<p>Sí: revisa la política de devoluciones en el pie de página. Queremos que te sientas tranquilo al elegir.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
