<section class="section-stub" aria-labelledby="PasswordHeading-{{ section.id }}">
  <div class="page-width">
    {% render 'logo', variant: 'lockup' %}

    <h1 id="PasswordHeading-{{ section.id }}">{{ 'general.password.title' | t }}</h1>
    <p>{{ 'general.password.subtext' | t }}</p>

    {%- form 'storefront_password' -%}
      <h2>{{ 'general.password.login_form_heading' | t }}</h2>
      <label for="Password-{{ section.id }}">{{ 'general.password.login_password_label' | t }}</label>
      <input id="Password-{{ section.id }}" type="password" name="password" autocomplete="current-password">
      <button type="submit">{{ 'general.password.login_submit' | t }}</button>
      {%- if form.errors -%}
        <p>{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <h2>{{ 'general.password.signup_form_heading' | t }}</h2>
      <label for="PasswordEmail-{{ section.id }}">{{ 'general.password.signup_email_label' | t }}</label>
      <input
        id="PasswordEmail-{{ section.id }}"
        type="email"
        name="contact[email]"
        autocomplete="email"
      >
      <button type="submit">{{ 'general.password.signup_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
