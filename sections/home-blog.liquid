{%- comment -%}
  Teaser de blog: últimos artículos de un blog picker. Si vacío, no rompe.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'home.blog.heading' | t
  endif

  assign blog = section.settings.blog
  assign post_limit = section.settings.post_limit | default: 3
-%}

{%- if blog != blank and blog.articles_count > 0 -%}
  <section class="home-blog" data-reveal-section aria-labelledby="BlogHeading-{{ section.id }}">
    <div class="page-width home-blog__inner">
      <div class="home-blog__header">
        <h2
          id="BlogHeading-{{ section.id }}"
          class="home-blog__heading"
          data-reveal="rise"
        >
          {{ heading | escape }}
        </h2>
        <a class="home-blog__all" href="{{ blog.url }}">{{ 'home.blog.view_all' | t }}</a>
      </div>

      <ul class="home-blog__list" role="list">
        {%- for article in blog.articles limit: post_limit -%}
          {%- liquid
            assign article_alt = article.image.alt | default: article.title
          -%}
          <li
            class="home-blog__item"
            data-reveal="rise"
            style="--reveal-i: {{ forloop.index0 }};"
          >
            <a class="home-blog__link" href="{{ article.url }}">
              {%- if article.image != blank -%}
                <div class="home-blog__media">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'home-blog__image',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 990px) 30vw, 100vw',
                      loading: 'lazy',
                      alt: article_alt
                  }}
                </div>
              {%- endif -%}
              <h3 class="home-blog__title">{{ article.title | escape }}</h3>
              {%- if article.excerpt != blank -%}
                <p class="home-blog__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              <span class="home-blog__more">{{ 'blog.read_more' | t }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.home_blog.name",
  "tag": "section",
  "class": "section-home-blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.home_blog.settings.heading.label",
      "default": "Tips con criterio"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.home_blog.settings.blog.label"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "t:sections.home_blog.settings.post_limit.label",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_blog.name"
    }
  ]
}
{% endschema %}
