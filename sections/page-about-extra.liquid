{%- comment -%}
  Extra para template about: tagline cercano + CTA a colecciones.
{%- endcomment -%}

{%- liquid
  assign tagline = section.settings.tagline
  if tagline == blank
    assign tagline = 'about.tagline' | t
  endif

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'about.cta_label' | t
  endif

  assign cta_url = blank
  if section.settings.collection != blank
    assign cta_url = section.settings.collection.url
  elsif section.settings.link != blank
    assign cta_url = section.settings.link
  else
    assign cta_url = routes.collections_url
  endif
-%}

<section class="about-extra" aria-labelledby="AboutExtra-{{ section.id }}">
  <div class="page-width about-extra__inner">
    <h2 id="AboutExtra-{{ section.id }}" class="visually-hidden">
      {{ 'about.extra_heading' | t }}
    </h2>
    <p class="about-extra__tagline">{{ tagline | escape }}</p>
    {%- if cta_url != blank -%}
      <a class="button about-extra__cta" href="{{ cta_url }}">{{ cta_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.page_about_extra.name",
  "tag": "section",
  "class": "section-page-about-extra",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "t:sections.page_about_extra.settings.tagline.label",
      "default": "Si buscas confort y seguridad para tu gato de interior, aquí estamos para ayudarte a elegir sin ruido."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.page_about_extra.settings.cta_label.label",
      "default": "Ver colecciones"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.page_about_extra.settings.collection.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.page_about_extra.settings.link.label",
      "info": "t:sections.page_about_extra.settings.link.info"
    }
  ]
}
{% endschema %}
