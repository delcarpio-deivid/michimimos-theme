{%- comment -%}
  Hasta 3 colecciones destacadas: imagen + nombre + enlace. Sin cards de marketing.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'home.collections.heading' | t
  endif

  assign has_any = false
  if section.settings.collection_1 != blank or section.settings.collection_2 != blank or section.settings.collection_3 != blank
    assign has_any = true
  endif
-%}

{%- if has_any -%}
  <section class="home-collections" aria-labelledby="CollectionsHeading-{{ section.id }}">
    <div class="page-width home-collections__inner">
      <h2 id="CollectionsHeading-{{ section.id }}" class="home-collections__heading">
        {{ heading | escape }}
      </h2>

      <ul class="home-collections__grid" role="list">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign featured = section.settings.collection_1
              when 2
                assign featured = section.settings.collection_2
              when 3
                assign featured = section.settings.collection_3
            endcase
          -%}
          {%- if featured != blank -%}
            <li class="home-collections__item">
              <a class="home-collections__link" href="{{ featured.url }}">
                {%- if featured.featured_image != blank -%}
                  <div class="home-collections__media">
                    {{
                      featured.featured_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'home-collections__image',
                        widths: '400, 600, 900',
                        sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw',
                        loading: 'lazy',
                        alt: featured.title
                    }}
                  </div>
                {%- else -%}
                  <div class="home-collections__media home-collections__media--empty" aria-hidden="true"></div>
                {%- endif -%}
                <span class="home-collections__title">{{ featured.title | escape }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.home_featured_collections.name",
  "tag": "section",
  "class": "section-home-featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.home_featured_collections.settings.heading.label",
      "default": "Empieza por aquí"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "t:sections.home_featured_collections.settings.collection_1.label"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "t:sections.home_featured_collections.settings.collection_2.label"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "t:sections.home_featured_collections.settings.collection_3.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_featured_collections.name"
    }
  ]
}
{% endschema %}
