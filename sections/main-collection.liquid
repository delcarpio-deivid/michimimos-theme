{%- comment -%}
  Colección: H1 + raya + descripción, sort + filtros en aside, grid + paginación.
{%- endcomment -%}

{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign show_description = section.settings.show_description
  assign description_position = section.settings.description_position | default: 'top'
  assign enable_filters = section.settings.enable_filters
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign show_top_description = false
  if show_description and description_position == 'top' and collection.description != blank
    assign show_top_description = true
  endif
-%}

<section class="collection-page" aria-labelledby="CollectionHeading-{{ section.id }}">
  <div class="page-width collection-page__inner">
    <header class="collection-page__header{% if show_top_description %} collection-page__header--with-desc{% endif %}">
      <h1 id="CollectionHeading-{{ section.id }}" class="collection-page__title">
        {{ collection.title | escape }}
      </h1>
      {%- if show_top_description -%}
        <span class="collection-page__rule" aria-hidden="true"></span>
        <div class="collection-page__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by products_per_page -%}
      <div class="collection-page__layout collection-page__layout--with-filters">
        <aside class="collection-filters" aria-label="{{ 'collections.filters_and_sort' | t }}">
          <details class="collection-filters__panel" open>
            <summary class="collection-filters__panel-summary">
              {{ 'collections.filters_and_sort' | t }}
            </summary>

            <div class="collection-filters__panel-body">
              {%- if enable_filters -%}
                {%- assign active_count = 0 -%}
                {%- for filter in collection.filters -%}
                  {%- if filter.type != 'price_range' -%}
                    {%- assign active_count = active_count | plus: filter.active_values.size -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if active_count > 0 -%}
                  <p class="collection-filters__active">
                    <a href="{{ collection.url }}?sort_by={{ sort_by | url_encode }}">
                      {{- 'collections.clear_filters' | t -}}
                    </a>
                  </p>
                {%- endif -%}
              {%- endif -%}

              <form
                id="CollectionFiltersForm-{{ section.id }}"
                class="collection-filters__form"
                method="get"
                action="{{ collection.url }}"
              >
                <div class="collection-filters__sort">
                  <label class="collection-filters__sort-label" for="SortBy-{{ section.id }}">
                    {{ 'collections.sort_by' | t }}
                  </label>
                  <select
                    class="collection-page__sort-select"
                    name="sort_by"
                    id="SortBy-{{ section.id }}"
                    onchange="this.form.submit()"
                  >
                    {%- for option in collection.sort_options -%}
                      <option
                        value="{{ option.value }}"
                        {% if option.value == sort_by %}
                          selected
                        {% endif %}
                      >
                        {{- option.name | escape -}}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>

                {%- if enable_filters -%}
                  {%- for filter in collection.filters -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- continue -%}
                    {%- endif -%}

                    {%- liquid
                      assign filter_has_visible = false
                      if filter.type == 'list' or filter.type == 'boolean'
                        for value in filter.values
                          if value.active or value.count > 0
                            assign filter_has_visible = true
                            break
                          endif
                        endfor
                      else
                        assign filter_has_visible = true
                      endif
                    -%}

                    {%- if filter_has_visible -%}
                      <details class="collection-filters__group" open>
                        <summary class="collection-filters__summary">{{ filter.label | escape }}</summary>

                        {%- case filter.type -%}
                          {%- when 'list', 'boolean' -%}
                            <ul class="collection-filters__list" role="list">
                              {%- for value in filter.values -%}
                                {%- if value.active or value.count > 0 -%}
                                  <li>
                                    <label class="collection-filters__option">
                                      <input
                                        type="checkbox"
                                        name="{{ value.param_name }}"
                                        value="{{ value.value }}"
                                        {% if value.active %}
                                          checked
                                        {% endif %}
                                        onchange="this.form.submit()"
                                      >
                                      <span>{{ value.label | escape }}</span>
                                      <span class="collection-filters__count">({{ value.count }})</span>
                                    </label>
                                  </li>
                                {%- endif -%}
                              {%- endfor -%}
                            </ul>
                        {%- endcase -%}
                      </details>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}

                <noscript>
                  <button type="submit" class="button">{{ 'collections.apply_filters' | t }}</button>
                </noscript>
              </form>
            </div>
          </details>
        </aside>

        <div class="collection-page__results">
          {%- if collection.products.size == 0 -%}
            <p class="collection-page__empty">{{ 'collections.empty' | t }}</p>
          {%- else -%}
            <ul class="collection-page__grid" role="list">
              {%- for product in collection.products -%}
                <li class="collection-page__item">
                  {% render 'product-card', product: product %}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <nav class="collection-page__pagination" aria-label="{{ 'collections.pagination' | t }}">
                {{ paginate | default_pagination }}
              </nav>
            {%- endif -%}

            {%- if paginate.pages <= 1 or paginate.current_page == paginate.pages -%}
              <p class="collection-page__more-soon">{{ 'collections.more_soon' | t }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}

    {%- if show_description and description_position == 'bottom' and collection.description != blank -%}
      <div class="collection-page__description collection-page__description--bottom rte">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 12,
      "label": "t:sections.main_collection.settings.products_per_page.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "t:sections.main_collection.settings.show_description.label"
    },
    {
      "type": "select",
      "id": "description_position",
      "label": "t:sections.main_collection.settings.description_position.label",
      "options": [
        {
          "value": "top",
          "label": "t:sections.main_collection.settings.description_position.options.top"
        },
        {
          "value": "bottom",
          "label": "t:sections.main_collection.settings.description_position.options.bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "default": true,
      "label": "t:sections.main_collection.settings.enable_filters.label",
      "info": "t:sections.main_collection.settings.enable_filters.info"
    }
  ]
}
{% endschema %}
