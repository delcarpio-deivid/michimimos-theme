{%- doc -%}
  Logo Michimimos (mark + wordmark desde assets/).
  @param {string} [class] - Clase CSS extra del enlace
  @param {boolean} [mark_only] - Solo el monograma
{%- enddoc -%}

{%- liquid
  assign logo_class = class | default: 'logo'
  assign brand = settings.brand_name | default: shop.name
-%}

<a
  href="{{ routes.root_url }}"
  class="{{ logo_class }}"
  aria-label="{{ 'general.accessibility.logo' | t }}"
>
  {%- if mark_only -%}
    <img
      src="{{ 'logo-mark.svg' | asset_url }}"
      alt=""
      width="40"
      height="40"
      class="logo__mark"
      loading="eager"
      decoding="async"
    >
  {%- else -%}
    <img
      src="{{ 'logo.svg' | asset_url }}"
      alt="{{ brand | escape }}"
      width="268"
      height="40"
      class="logo__full"
      loading="eager"
      decoding="async"
    >
  {%- endif -%}
</a>
