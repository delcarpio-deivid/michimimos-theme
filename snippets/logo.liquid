{%- doc -%}
  Logo Michimimos: mark SVG + wordmark tipográfico (legible).
  @param {string} [class] - Clase CSS extra del enlace
  @param {boolean} [mark_only] - Solo el monograma
{%- enddoc -%}

{%- liquid
  assign logo_class = class | default: 'logo'
  assign brand = settings.brand_name | default: shop.name
-%}

<a
  href="{{ routes.root_url }}"
  class="{{ logo_class }}"
  aria-label="{{ 'general.accessibility.logo' | t }}"
>
  <img
    src="{{ 'logo-mark.svg' | asset_url }}"
    alt=""
    width="40"
    height="40"
    class="logo__mark"
    loading="eager"
    decoding="async"
  >
  {%- unless mark_only -%}
    <span class="logo__wordmark">{{ brand | escape }}</span>
  {%- endunless -%}
</a>
