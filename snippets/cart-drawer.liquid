{%- comment -%}
  Drawer ligero de carrito (estado inicial Liquid). Abre desde header.
{%- endcomment -%}

{%- liquid
  assign rascadores = collections['rascadores']
  if rascadores != blank
    assign empty_cta_url = rascadores.url
  else
    assign empty_cta_url = routes.collections_url
  endif
-%}

<dialog
  id="CartDrawer"
  class="cart-drawer"
  data-cart-drawer
  aria-labelledby="CartDrawerTitle"
>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">{{ 'cart.title' | t }}</h2>
      <button
        type="button"
        class="cart-drawer__close"
        data-cart-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <span class="cart-drawer__close-label">{{ 'accessibility.close' | t }}</span>
      </button>
    </div>

    <div class="cart-drawer__body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty-state">
          <p class="cart-drawer__empty">{{ 'cart.empty' | t }}</p>
          <a class="button button--secondary" href="{{ empty_cta_url }}" data-cart-close>
            {{ 'cart.empty_cta' | t }}
          </a>
        </div>
      {%- else -%}
        <ul class="cart-drawer__list" role="list">
          {%- for item in cart.items -%}
            {%- liquid
              assign img_alt = item.image.alt | default: item.product.title
            -%}
            <li class="cart-drawer__item">
              {%- if item.image -%}
                <a href="{{ item.url }}" class="cart-drawer__thumb" tabindex="-1">
                  {{
                    item.image
                    | image_url: width: 120
                    | image_tag:
                      loading: 'lazy',
                      widths: '60, 120',
                      sizes: '60px',
                      alt: img_alt,
                      width: 60,
                      height: 60
                  }}
                </a>
              {%- endif -%}
              <div class="cart-drawer__item-info">
                <a href="{{ item.url }}" class="cart-drawer__item-title">
                  {{- item.product.title | escape -}}
                </a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-drawer__item-variant">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                <p class="cart-drawer__item-meta">
                  {{ item.quantity }} × {{ item.final_price | money }}
                </p>
                <a
                  href="{{ item.url_to_remove }}"
                  class="cart-drawer__remove"
                  aria-label="{{ 'cart.remove_item' | t: title: item.product.title }}"
                >
                  {{- 'cart.remove' | t -}}
                </a>
              </div>
              <p class="cart-drawer__item-price">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        <p class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money_with_currency }}</strong>
        </p>
        <a class="button button--secondary" href="{{ routes.cart_url }}">
          {{ 'cart.view_cart' | t }}
        </a>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button">
            {{ 'cart.checkout' | t }}
          </button>
        </form>
      </div>
    {%- endif -%}
  </div>
</dialog>
