{%- comment -%}
  Title, description, canonical, Open Graph / Twitter.
  JSON-LD: defaults Shopify vía content_for_header (sin schema custom).
{%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description
  assign og_type = 'website'
  assign og_image = blank

  if request.page_type == 'index'
    assign og_title = shop.name
  elsif request.page_type == 'product'
    assign og_type = 'product'
    assign og_title = product.title | default: og_title
    if product.featured_media != blank
      assign og_image = product.featured_media
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    assign og_title = article.title | default: og_title
    if article.image != blank
      assign og_image = article.image
    endif
  elsif request.page_type == 'collection'
    if collection.image != blank
      assign og_image = collection.image
    endif
  elsif request.page_type == 'page'
    if page.image != blank
      assign og_image = page.image
    endif
  endif

  assign og_image_url = blank
  if og_image != blank
    assign og_image_url = og_image | image_url: width: 1200
    unless og_image_url contains '://'
      assign og_image_url = og_image_url | prepend: 'https:'
    endunless
  endif
-%}

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

{% if og_description != blank %}
  <meta name="description" content="{{ og_description | escape }}">
{% endif %}

<link rel="canonical" href="{{ canonical_url }}">

<link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="any">
<link rel="icon" type="image/png" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32">
<link rel="icon" type="image/png" href="{{ 'favicon-192.png' | asset_url }}" sizes="192x192">
<link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{% if og_description != blank %}
  <meta property="og:description" content="{{ og_description | escape }}">
{% endif %}
{% if og_image_url != blank %}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta property="og:image:secure_url" content="{{ og_image_url }}">
{% endif %}

{% if og_image_url != blank %}
  <meta name="twitter:card" content="summary_large_image">
{% else %}
  <meta name="twitter:card" content="summary">
{% endif %}
<meta name="twitter:title" content="{{ og_title | escape }}">
{% if og_description != blank %}
  <meta name="twitter:description" content="{{ og_description | escape }}">
{% endif %}
{% if og_image_url != blank %}
  <meta name="twitter:image" content="{{ og_image_url }}">
{% endif %}
