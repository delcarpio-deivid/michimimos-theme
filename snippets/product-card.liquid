{%- comment -%}
  Product card for collection grids (and related later).
  Params: product (required)
{%- endcomment -%}

{%- unless product == blank -%}
  {%- liquid
    assign featured = product.featured_media
    assign img_alt = featured.alt | default: product.title
    assign show_compare = false
    if product.compare_at_price > product.price
      assign show_compare = true
    endif
  -%}

  <article class="product-card">
    <a class="product-card__link" href="{{ product.url }}">
      <div class="product-card__media">
        {%- if featured != blank -%}
          {{
            featured
            | image_url: width: 800
            | image_tag:
              class: 'product-card__image',
              widths: '300, 400, 600, 800',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              loading: 'lazy',
              alt: img_alt
          }}
        {%- else -%}
          <div class="product-card__placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      <h3 class="product-card__title">{{ product.title | escape }}</h3>
      <p class="product-card__price">
        <span class="visually-hidden">{{ 'products.price' | t }}</span>
        {%- if show_compare -%}
          <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="product-card__price-current">{{ product.price | money }}</span>
      </p>
    </a>
  </article>
{%- endunless -%}
